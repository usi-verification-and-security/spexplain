#!/bin/bash

function usage {
    local script=$(basename "$0")

    printf "USAGE: %s <dir> [<specific_target_image>]\n" "$script"
    printf "EXAMPLES:\n"
    printf "\t%s cav25\n" "$script"
    printf "\t%s cav25 fedora:latest\n" "$script"
    printf "ENVIRONMENT VARIABLES:\n"
    printf "\t<ARG>\tany build argument of the Dockerfile, e.g. SPEXPLAIN_GIT_TAG (build.sh)\n"
    printf "\tPLATFORM\tthe target platform, e.g. linux/arm64 (all)\n"
    printf "\tDOCKER_BUILD_ARGS\tadditional arguments of docker build (build.sh)\n"
    printf "\tOUTPUT\ta host directory mounted at the output directory of the image, e.g. data/output (run.sh)\n"
    printf "\tX11\tif set, connect to the X11 display of the host, e.g. for --show (run.sh)\n"
    printf "\tDOCKER_RUN_ARGS\tadditional arguments of docker run (run.sh)\n"

    [[ -n $1 ]] && exit $1
}

[[ -z $1 ]] && usage 0

DIR="$1"
shift

DIRBASE=$(basename "$DIR")
DIRBASE=${DIRBASE%% *}

REPO=spexplain
TAG=latest

[[ -n $1 ]] && {
    TARGET=$1
    shift

    REPO+=-${TARGET%:*}
    tag=${TARGET#*:}
    [[ -n $tag ]] && TAG=$tag
}

REPO+=-$DIRBASE

[[ -n $PLATFORM ]] && TAG+=-${PLATFORM##*/}

IMAGE=$REPO:$TAG
