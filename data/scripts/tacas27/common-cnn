## Shared driver for the per-benchmark TACAS'27 CNN (ONNX) run scripts.
## Each <KEYWORD>-CNN.sh sets NAME and TIMEOUT_PER and then sources this file.
## This is the ONNX counterpart of ./common: it runs run-experiments2.sh (explain-onnx) on the
## CNN-bench models data/models/<NAME>/cnn-bench/<id>.onnx (see data/models/CNN_BENCH_REPORT.md).
##
## USAGE: ./<KEYWORD>-CNN.sh [<model>...] [-n]
##
## A <model> is a model id of the family (S1 P1 S2 P2 S3 P3 S4 P4 S6 P6 S8 P8) or a path to an
## .onnx file; bare arguments replace the default models. '-' arguments are forwarded to
## run-experiments2.sh. Every model is paired with the benchmark's dataset.
##
## Environment variables (all optional):
##   MODEL_IDS         model ids to run (default: all 12, simplest first); ignored when models
##                     are given as arguments
##   MODEL_SET         subdirectory of data/models/<NAME>/ with the models (default: cnn-bench)
##   VARIANTS          space-separated variant names from spec/variants/all, e.g. "naive fix-all";
##                     takes precedence over VARIANTS_SPEC
##   VARIANTS_SPEC     variants collection in spec/variants (default: neuron_activations)
##   EXPERIMENTS_SPEC  experiments collection (default: plain_itp)
##   FILTER            regex over '<variant>/<experiment>' identifiers
##   MAX_SAMPLES       process only this many (shuffled) samples of the dataset
##   DATASET           dataset CSV (default: data/datasets/<NAME>/<DATASET_BASE>.csv)
##   DATASET_BASE      basename of the default dataset (default: <NAME>_s100_scaled, the same
##                     100 samples as the FC experiments; set per benchmark if there is none)
##   INPUT_MIN/MAX     input domain bounds (default: 0 and 1, the domain of all CNN-bench models)
##   TIMEOUT_PER       per-explanation timeout (default: per benchmark)
##   TIMEOUT           per-experiment timeout (GNU timeout interval, e.g. 30m)
##   TIMEOUT_ALL       whole-run timeout, HH:MM:SS or MM:SS or a GNU timeout
##                     interval (default: 23:55:00); 'none' disables it
##   CPU_PERCENTAGE    percentage of CPUs to use (default: 50)
##   DRY_RUN=1         only print what would have been run
##   WRAPPER           prefix for the call, e.g. a path to sbatch.sh

[[ -n $NAME ]] || {
    printf "NAME is not set - do not run 'common-cnn' directly.\n" >&2
    exit 1
}

[[ -z $MODEL_SET ]] && MODEL_SET=cnn-bench

## realpath before dirname, so that the script works from any directory
SCRIPTS_DIR=$(dirname "$(dirname "$(realpath "$0")")")
DATA_DIR=$(dirname "$SCRIPTS_DIR")

RUN_SCRIPT="$SCRIPTS_DIR/run-experiments2.sh"

[[ -x $RUN_SCRIPT ]] || {
    printf "Not an executable run script: %s\n" "$RUN_SCRIPT" >&2
    exit 1
}

export CPU_PERCENTAGE=${CPU_PERCENTAGE:-50}
export EXPERIMENTS_SPEC=${EXPERIMENTS_SPEC:-plain_itp}
export VARIANTS_SPEC=${VARIANTS_SPEC:-neuron_activations}
export TIMEOUT_PER
## All CNN-bench models take pixels in [0,1]; run1-2.sh expands a single number to every feature
export INPUT_MIN=${INPUT_MIN:-0}
export INPUT_MAX=${INPUT_MAX:-1}

## An explicit list of variants becomes a generated variants spec, which run-experiments2.sh
## reads like any other (and checks against spec/variants/all). It lives next to the scripts,
## so that it is also visible on the compute node under a WRAPPER such as sbatch.
[[ -n $VARIANTS ]] && {
    read -ra variant_names <<<"$VARIANTS"
    (( ${#variant_names[@]} )) || {
        printf "VARIANTS is set but empty.\n" >&2
        exit 1
    }
    variants_dir="$SCRIPTS_DIR/tacas27/.variants"
    mkdir -p "$variants_dir" || exit $?
    VARIANTS_SPEC="$variants_dir/$(IFS=+; printf "%s" "${variant_names[*]}")"
    {
        printf "## Generated by tacas27/common-cnn from VARIANTS='%s'\n" "$VARIANTS"
        printf "VARIANT_NAMES=(\n"
        printf "    %s\n" "${variant_names[@]}"
        printf ")\n"
    } >"$VARIANTS_SPEC" || exit $?
}

## Whole-run timeout. run-experiments2.sh only knows TIMEOUT, which run1-2.sh
## applies to every experiment separately, so the batch is bounded here instead.
[[ -z $TIMEOUT_ALL ]] && TIMEOUT_ALL=23:55:00

TIMEOUT_CMD=()
if [[ $TIMEOUT_ALL != none ]]; then
    ## GNU timeout takes NUMBER[smhd], so convert the Slurm-like formats
    if [[ $TIMEOUT_ALL =~ ^([0-9]+):([0-5][0-9]):([0-5][0-9])$ ]]; then
        timeout_secs=$(( 10#${BASH_REMATCH[1]}*3600 + 10#${BASH_REMATCH[2]}*60 + 10#${BASH_REMATCH[3]} ))
    elif [[ $TIMEOUT_ALL =~ ^([0-9]+):([0-5][0-9])$ ]]; then
        timeout_secs=$(( 10#${BASH_REMATCH[1]}*60 + 10#${BASH_REMATCH[2]} ))
    elif [[ $TIMEOUT_ALL =~ ^[0-9]+(\.[0-9]*)?[smhd]?$ ]]; then
        timeout_secs="$TIMEOUT_ALL"
    else
        printf "Unrecognized whole-run timeout: %s\n" "$TIMEOUT_ALL" >&2
        exit 1
    fi
    TIMEOUT_CMD=(timeout "$timeout_secs")
fi

MODEL_DIR="$DATA_DIR/models/$NAME/$MODEL_SET"

## Split the arguments into models and options forwarded to run-experiments2.sh
MODELS=()
OPTS=()
for arg; do
    if [[ $arg =~ ^- ]]; then
        OPTS+=("$arg")
    elif [[ $arg == */* || $arg == *.onnx ]]; then
        MODELS+=("$arg")
    else
        MODELS+=("$MODEL_DIR/$arg.onnx")
    fi
done

[[ $DRY_RUN == 1 ]] && OPTS+=(-n)
[[ -n $FILTER ]] && OPTS=("$FILTER" "${OPTS[@]}")
[[ -n $MAX_SAMPLES ]] && OPTS=("$MAX_SAMPLES" "${OPTS[@]}")

## Default model set: the whole family, ordered by depth, strided before pooled
[[ -z $MODEL_IDS ]] && MODEL_IDS="S1 P1 S2 P2 S3 P3 S4 P4 S6 P6 S8 P8"

(( ${#MODELS[@]} )) || {
    for id in $MODEL_IDS; do
        MODELS+=("$MODEL_DIR/$id.onnx")
    done
}

[[ -z $DATASET_BASE ]] && DATASET_BASE="${NAME}_s100_scaled"
[[ -z $DATASET ]] && DATASET="$DATA_DIR/datasets/$NAME/$DATASET_BASE.csv"

[[ -r $DATASET ]] || {
    printf "Cannot read the dataset: %s\n" "$DATASET" >&2
    exit 1
}

ARGS=()
for model in "${MODELS[@]}"; do
    [[ -r $model ]] || {
        printf "Cannot read the model: %s\n" "$model" >&2
        exit 1
    }
    ARGS+=("$model" "$DATASET")
done

model_names=()
for model in "${MODELS[@]}"; do
    model_names+=("$(basename "$model" .onnx)")
done

printf "Benchmark:   %s (%s)\n" "$NAME" "$MODEL_SET"
printf "Models:      %s\n" "${model_names[*]}"
printf "Dataset:     %s\n" "${DATASET##*/}"
printf "Experiments: %s\n" "$EXPERIMENTS_SPEC"
printf "Variants:    %s\n" "${VARIANTS:-$VARIANTS_SPEC}"
[[ -n $MAX_SAMPLES ]] && printf "Max samples: %s\n" "$MAX_SAMPLES"
printf "Timeout per: %s\n" "$TIMEOUT_PER"
printf "Timeout all: %s\n\n" "$TIMEOUT_ALL"

export VARIANTS_SPEC

## The timeout goes after WRAPPER, so that under sbatch it bounds the work on
## the compute node rather than the submission itself
$WRAPPER "${TIMEOUT_CMD[@]}" "$RUN_SCRIPT" "${ARGS[@]}" "$EXPERIMENTS_SPEC" "${OPTS[@]}"
status=$?

(( $status == 124 )) && {
    printf "\nTimeout after %s: %s\n" "$TIMEOUT_ALL" "$NAME" >&2
    exit $status
}

exit $status
