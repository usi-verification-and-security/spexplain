## Examples for the CNN (ONNX) runs; see ./common-cnn for all env. variables.
## Models:      MODEL_IDS="NP1 NA1 ..." (default: all 36), or ids/paths as arguments
## Variants:    VARIANTS="naive guide-all ..." (names from spec/variants/all), or VARIANTS_SPEC=<collection>
## Samples:     MAX_SAMPLES=<n> processes <n> shuffled samples instead of all 100; results go to
##              an extra Sn<n>/ subdirectory, e.g. explanations/mnist/cnn-bench/S1/s100_scaled/naive/Sn10/
## Timeouts:    TIMEOUT_PER=<t> per explanation (defaults: MN 10m, CIF 10m, GTS 14m, IMN 1h),
##              TIMEOUT=<t> per experiment, TIMEOUT_ALL=<HH:MM:SS> for the whole run (default 23:55:00)

## ===================================================================================
## The model family (36 models, see data/models/CNN_BENCH_REPORT.md). The runs below are
## organised by *pooling kind*, because that is what decides the encoding:
##   nopool  S<d>/NS<d>  stride-2 downsampling, no pooling layer -- only ReLUs to encode
##   avg     A<d>/NA<d>  2x2 average pooling -- affine, no extra variable, NO disjunction
##   max     P<d>/NP<d>  2x2 max pooling -- a fresh variable + a 4-way disjunction per output
## Each kind is split in half by size (ReLU count ascending), giving six 6-model sets:
##
##   nopool-small  NS1 NS2 S1 NS3 S2 NS4
##   nopool-large  NS5 NS6 S3 S4 S5 S6
##   avg-small     NA1 NA2 A1 A2 NA3 A3
##   avg-large     NA4 NA5 NA6 A4 A5 A6
##   max-small     NP1 NP2 P1 P2 NP3 P3
##   max-large     NP4 NP5 NP6 P4 P5 P6
##
## A<d>/P<d> and NA<d>/NP<d> are twins: same shape, same ReLU count, same parameter count, so
## 'avg-*' vs 'max-*' at the same position isolates the cost of max-pool branching, and
## 'N*' vs its wide twin isolates the cost of width.
## ===================================================================================

## ---------- Quick checks ----------

## Dry run: what would be run for one avg/max twin pair and two variants
DRY_RUN=1 MODEL_IDS="A1 P1" VARIANTS="naive guide-all" ./data/scripts/tacas27/MN-CNN.sh

## First 10 shuffled samples of every model, default variants and timeouts
NAME=MNCNN-Sn10 MAX_SAMPLES=10 WRAPPER=~/srun_commands/sbatch.sh ./data/scripts/tacas27/MN-CNN.sh
NAME=CIFCNN-Sn10 MAX_SAMPLES=10 WRAPPER=~/srun_commands/sbatch.sh ./data/scripts/tacas27/CIF-CNN.sh
NAME=GTSCNN-Sn10 MAX_SAMPLES=10 WRAPPER=~/srun_commands/sbatch.sh ./data/scripts/tacas27/GTS-CNN.sh
NAME=IMNCNN-Sn10 MAX_SAMPLES=10 WRAPPER=~/srun_commands/sbatch.sh ./data/scripts/tacas27/IMN-CNN.sh

## The three pooling kinds at their smallest size, 10 samples -- the cheapest end-to-end check
NAME=MNCNN-triple-Sn10 MAX_SAMPLES=10 MODEL_IDS="NS1 NS2 NA1 NA2 NP1 NP2" WRAPPER=~/srun_commands/sbatch.sh ./data/scripts/tacas27/MN-CNN.sh

## Avg vs. max on one twin pair, all four neuron-activation variants
NAME=CIFCNN-A1P1 MODEL_IDS="A1 P1" WRAPPER=~/srun_commands/sbatch.sh ./data/scripts/tacas27/CIF-CNN.sh

## Longer per-explanation timeout for a single model
NAME=GTSCNN-S1 TIMEOUT_PER=1h WRAPPER=~/srun_commands/sbatch.sh ./data/scripts/tacas27/GTS-CNN.sh S1

## One variant, one experiment of the plain_itp spec
NAME=MNCNN-max-large-prefer MODEL_IDS="NP4 NP5 NP6 P4 P5 P6" VARIANTS=guide-all EXPERIMENTS_SPEC=plain_itp FILTER='/itp_aweak_bstrong$' WRAPPER=~/srun_commands/sbatch.sh ./data/scripts/tacas27/MN-CNN.sh

